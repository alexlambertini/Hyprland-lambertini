[global]
    monitor = 0
    follow = mouse
    width = (280, 420)
    origin = top-right
    offset = (12, 12)
    notification_limit = 5
    gap_size = 6
    frame_width = 1
    frame_color = "#ffffff22"
    separator_color = frame
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    corner_radius = 0
    font = JetBrains Mono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    word_wrap = yes
    ellipsize = end
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    background = "#1e1e2ef7"
    foreground = "#cccccc"
    highlight = "#df6124"
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    transparency = 0

[urgency_low]
    background = "#1e1e2ef7"
    foreground = "#cccccc"
    frame_color = "#ffffff18"
    timeout = 4

[urgency_normal]
    background = "#1e1e2ef7"
    foreground = "#cccccc"
    frame_color = "#df612466"
    timeout = 6

[urgency_critical]
    background = "#1e1e2ef7"
    foreground = "#cccccc"
    frame_color = "#eb7087"
    timeout = 0

[music]
    appname = "music-notify"
    frame_color = "#df6124"
    highlight = "#df6124"
    timeout = 4
