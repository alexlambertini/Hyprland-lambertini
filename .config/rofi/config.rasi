configuration {
    modi: "combi,drun,run,window,filebrowser,calc:/home/lambertini/.config/rofi/scripts/rofi-calc.sh";
    combi-modes: "drun,run,window";
    show-icons: true;
    display-drun: "󰀻 Apps";
    display-run: "> Executar";
    display-window: "󰖯 Janelas";
    display-filebrowser: "󰉋 Arquivos";
    display-calc: "󰃬 Calc";
    display-combi: "󰍉";
    drun-display-format: "{name}";
    window-format: "{w} · {c} · {t}";
    combi-display-format: "{mode} {text}";
    font: "JetBrains Mono Nerd Font 12";
}

@theme "theme"
