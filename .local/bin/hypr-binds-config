#!/usr/bin/env python3
import json
import os
import re
import subprocess

os.environ.setdefault("GTK_THEME", "Adwaita:dark")

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

CONF_DIR = os.path.expanduser("~/.config/hypr")
JSON_PATH = os.path.join(CONF_DIR, "custom-binds.json")
LUA_PATH = os.path.join(CONF_DIR, "custom-binds.lua")
MAIN_LUA = os.path.join(CONF_DIR, "hyprland.lua")

MOD_OPTIONS = ["SUPER", "SUPER SHIFT", "SUPER CTRL", "SUPER ALT",
               "SUPER SHIFT CTRL", "SUPER SHIFT ALT", "SUPER CTRL ALT",
               "ALT", "CTRL", "SHIFT", "CTRL ALT", ""]


def load_binds():
    if not os.path.isfile(JSON_PATH):
        return []
    try:
        with open(JSON_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, list):
            return data
    except Exception:
        pass
    return []


def lua_str(s):
    s = s.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
    return '"' + s + '"'


def mods_to_combo(mods):
    mods = (mods or "").strip()
    if not mods:
        return "SUPER"
    parts = [p for p in mods.replace("+", " ").split() if p]
    norm = []
    for p in parts:
        u = p.upper()
        if u in ("SUPER", "SHIFT", "CTRL", "ALT"):
            norm.append(u)
    order = ["SUPER", "SHIFT", "CTRL", "ALT"]
    norm = [m for m in order if m in norm]
    return " ".join(norm) if norm else "SUPER"


def combo_to_bind_mods(combo):
    combo = (combo or "").strip()
    parts = [p for p in combo.split() if p]
    order = ["SUPER", "SHIFT", "CTRL", "ALT"]
    parts = [m for m in order if m in parts]
    return " + ".join(parts) if parts else "SUPER"


def generate_lua(binds):
    lines = [
        "-- Atalhos personalizados (gerenciado por: hypr-binds-config / \"Atalhos Personalizados\")",
        "-- NÃO edite manualmente: alterações podem ser sobrescritas pelo painel.",
        "",
    ]
    for b in binds:
        if not isinstance(b, dict):
            continue
        if b.get("enabled", True) is False:
            continue
        key = str(b.get("key", "")).strip()
        cmd = str(b.get("command", "")).strip()
        mods = combo_to_bind_mods(b.get("mods", "SUPER"))
        desc = str(b.get("description", "")).strip()
        if not key or not cmd:
            continue
        bind_str = f"{mods} + {key}" if mods else key
        if desc:
            safe_desc = desc.replace("--", "-").replace("\n", " ")
            lines.append(f"-- {safe_desc}")
        lines.append(f"hl.bind({lua_str(bind_str)}, hl.dsp.exec_cmd({lua_str(cmd)}))")
        lines.append("")
    if len(lines) == 3:
        lines.append("-- (nenhum atalho personalizado)")
        lines.append("")
    return "\n".join(lines)


def save_all(binds):
    os.makedirs(CONF_DIR, exist_ok=True)
    with open(JSON_PATH, "w", encoding="utf-8") as f:
        json.dump(binds, f, ensure_ascii=False, indent=2)
        f.write("\n")
    with open(LUA_PATH, "w", encoding="utf-8") as f:
        f.write(generate_lua(binds))
    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def parse_existing_binds():
    """Best-effort read-only parse of binds from hyprland.lua."""
    if not os.path.isfile(MAIN_LUA):
        return []
    try:
        with open(MAIN_LUA, "r", encoding="utf-8") as f:
            text = f.read()
    except Exception:
        return []

    results = []
    seen = set()

    def add(keytxt, action):
        item = (keytxt.strip(), action.strip())
        if not item[0] or item in seen:
            return
        seen.add(item)
        results.append({"keys": item[0], "action": item[1]})

    # hl.bind(mainMod .. " + X", hl.dsp.exec_cmd(...)) / variable action
    for m in re.finditer(r'hl\.bind\(\s*mainMod\s*\.\.\s*"([^"]+)"\s*,\s*([^\n]+)\)\s*(?:,|\n|\))', text):
        k = "SUPER" + m.group(1)
        a = m.group(2).strip().rstrip(",)")
        add(k, simplify_action(a))

    # hl.bind("SUPER + X", ...)
    for m in re.finditer(r'hl\.bind\(\s*"([^"]+)"\s*,\s*([^\n]+)\)\s*(?:,|\n|\))', text):
        k = m.group(1)
        a = m.group(2).strip().rstrip(",)")
        add(k, simplify_action(a))

    # workspace loop hint
    if re.search(r'for\s+i\s*=\s*1\s*,\s*10', text) and re.search(r'workspace', text):
        add("SUPER + 1..0", "Trocar para workspace 1..10")
        add("SUPER + SHIFT + 1..0", "Mover janela para workspace 1..10")

    # mouse binds common
    for m in re.finditer(r'hl\.bind\(\s*mainMod\s*\.\.\s*"([^"]*mouse[^"]*)"\s*,\s*([^\n]+)\)', text):
        add("SUPER" + m.group(1), simplify_action(m.group(2)))

    return results


def simplify_action(a):
    a = a.strip()
    m = re.search(r'hl\.dsp\.exec_cmd\("([^"]*)"\)', a)
    if m:
        return f"Executar: {m.group(1)}"
    m = re.search(r"hl\.dsp\.exec_cmd\('([^']*)'\)", a)
    if m:
        return f"Executar: {m.group(1)}"
    m = re.search(r'hl\.dsp\.exec_cmd\(([^)]+)\)', a)
    if m:
        v = m.group(1).strip()
        if v in ("terminal", "fileManager", "menu"):
            return f"Executar: {v}"
        return f"Executar: {v}"
    if "window.close" in a:
        return "Fechar janela"
    if "window.float" in a or "toggle" in a and "float" in a:
        return "Alternar flutuante (ou ação)"
    if "window.pseudo" in a:
        return "Pseudo-tile"
    if "togglesplit" in a:
        return "Alternar split (layout)"
    if "window.drag" in a:
        return "Arrastar janela (mouse)"
    if "window.resize" in a and "mouse" in a:
        return "Redimensionar janela (mouse)"
    if "window.resize" in a:
        return "Redimensionar janela"
    if "window.move" in a and "direction" in a:
        return "Mover janela (direção)"
    if "window.move" in a and "workspace" in a:
        return "Mover janela para workspace"
    if "focus" in a and "workspace" in a:
        return "Focar workspace"
    if "focus" in a and "monitor" in a:
        return "Focar monitor"
    a = re.sub(r"\s+", " ", a)
    return a[:120] + ("…" if len(a) > 120 else "")


CSS = b"""
window, .background { background-color: #1e1e2e; color: #cccccc; }
label { color: #cccccc; }
label.title { font-size: 16px; font-weight: 700; color: #cccccc; }
label.muted { color: #8a8a8a; }
entry, textview, spinbutton { background: #252536; color: #cccccc; border: 1px solid #3a3a4a; border-radius: 6px; padding: 6px; }
entry:focus { border-color: #df6124; }
combobox, combobox box, combobox button { background: #252536; color: #cccccc; }
treeview { background: #252536; color: #cccccc; }
treeview:selected, treeview:selected:focus { background: #df612455; color: #ffffff; }
button { background: #2a2a3a; color: #cccccc; border: 1px solid #3a3a4a; border-radius: 8px; padding: 6px 12px; }
button:hover { background: #353548; border-color: #df6124; }
button.suggested-action { background: #df6124; color: #1e1e2e; border-color: #df6124; font-weight: 700; }
button.suggested-action:hover { background: #ff7a3a; }
button.destructive-action { background: #3a2a2a; color: #f38ba8; border-color: #5a3a3a; }
scrolledwindow { border: 1px solid #3a3a4a; border-radius: 6px; }
notebook header { background: #252536; }
notebook tab { padding: 6px 10px; color: #cccccc; }
notebook tab:checked { color: #df6124; }
"""


class BindDialog(Gtk.Dialog):
    def __init__(self, parent, title, bind=None):
        super().__init__(title=title, transient_for=parent, flags=0)
        self.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OK, Gtk.ResponseType.OK)
        self.set_default_size(520, 260)
        box = self.get_content_area()
        box.set_spacing(8)
        box.set_border_width(12)

        grid = Gtk.Grid(column_spacing=8, row_spacing=8)
        box.add(grid)

        bind = bind or {}
        mods = mods_to_combo(bind.get("mods", "SUPER"))

        grid.attach(Gtk.Label(label="Modificadores", xalign=0), 0, 0, 1, 1)
        self.mods = Gtk.ComboBoxText()
        for m in MOD_OPTIONS:
            self.mods.append_text(m if m else "(nenhum)")
        try:
            idx = MOD_OPTIONS.index(mods)
        except ValueError:
            idx = 0
        self.mods.set_active(idx)
        grid.attach(self.mods, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label="Tecla", xalign=0), 0, 1, 1, 1)
        self.key = Gtk.Entry()
        self.key.set_placeholder_text("ex.: T, F1, Return, Print")
        self.key.set_text(str(bind.get("key", "")))
        grid.attach(self.key, 1, 1, 1, 1)

        grid.attach(Gtk.Label(label="Comando", xalign=0), 0, 2, 1, 1)
        self.cmd = Gtk.Entry()
        self.cmd.set_placeholder_text("ex.: kitty, firefox, ~/.local/bin/script.sh")
        self.cmd.set_text(str(bind.get("command", "")))
        grid.attach(self.cmd, 1, 2, 1, 1)

        grid.attach(Gtk.Label(label="Descrição", xalign=0), 0, 3, 1, 1)
        self.desc = Gtk.Entry()
        self.desc.set_placeholder_text("opcional")
        self.desc.set_text(str(bind.get("description", "")))
        grid.attach(self.desc, 1, 3, 1, 1)

        self.key.set_hexpand(True)
        self.cmd.set_hexpand(True)
        self.desc.set_hexpand(True)
        self.show_all()

    def get_bind(self):
        mods_txt = self.mods.get_active_text() or "SUPER"
        if mods_txt == "(nenhum)":
            mods_txt = ""
        return {
            "mods": mods_txt.strip(),
            "key": self.key.get_text().strip(),
            "command": self.cmd.get_text().strip(),
            "description": self.desc.get_text().strip(),
            "enabled": True,
        }


class BindsWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Atalhos Personalizados")
        self.set_default_size(760, 460)
        self.set_border_width(14)
        self.set_position(Gtk.WindowPosition.CENTER)

        provider = Gtk.CssProvider()
        try:
            provider.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )
        except Exception:
            pass

        self.binds = load_binds()

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(outer)

        title = Gtk.Label(label="Atalhos do Hyprland")
        title.get_style_context().add_class("title")
        title.set_halign(Gtk.Align.START)
        outer.pack_start(title, False, False, 0)

        sub = Gtk.Label(label="“Personalizados”: editáveis (salvos em custom-binds.lua). “Atuais (sistema)”: leitura dos binds do hyprland.lua.")
        sub.get_style_context().add_class("muted")
        sub.set_halign(Gtk.Align.START)
        sub.set_line_wrap(True)
        outer.pack_start(sub, False, False, 0)

        notebook = Gtk.Notebook()
        outer.pack_start(notebook, True, True, 0)

        # Tab custom
        custom_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        custom_box.set_border_width(8)
        notebook.append_page(custom_box, Gtk.Label(label="Personalizados"))

        self.store = Gtk.ListStore(str, str, str)
        self.view = Gtk.TreeView(model=self.store)
        for i, col in enumerate(("Atalho", "Comando", "Descrição")):
            renderer = Gtk.CellRendererText()
            column = Gtk.TreeViewColumn(col, renderer, text=i)
            column.set_resizable(True)
            if i == 1:
                column.set_expand(True)
            self.view.append_column(column)

        sc = Gtk.ScrolledWindow()
        sc.set_vexpand(True)
        sc.add(self.view)
        custom_box.pack_start(sc, True, True, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        custom_box.pack_start(actions, False, False, 0)

        add_btn = Gtk.Button(label="Adicionar")
        add_btn.connect("clicked", self.on_add)
        actions.pack_start(add_btn, False, False, 0)

        edit_btn = Gtk.Button(label="Editar")
        edit_btn.connect("clicked", self.on_edit)
        actions.pack_start(edit_btn, False, False, 0)

        del_btn = Gtk.Button(label="Remover")
        del_btn.get_style_context().add_class("destructive-action")
        del_btn.connect("clicked", self.on_remove)
        actions.pack_start(del_btn, False, False, 0)

        spacer = Gtk.Label()
        actions.pack_start(spacer, True, True, 0)

        save_btn = Gtk.Button(label="Salvar e aplicar")
        save_btn.get_style_context().add_class("suggested-action")
        save_btn.connect("clicked", self.on_save)
        actions.pack_start(save_btn, False, False, 0)

        # Tab system
        sys_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sys_box.set_border_width(8)
        notebook.append_page(sys_box, Gtk.Label(label="Atuais (sistema)"))

        self.sys_store = Gtk.ListStore(str, str)
        sys_view = Gtk.TreeView(model=self.sys_store)
        for i, col in enumerate(("Atalho", "Ação")):
            renderer = Gtk.CellRendererText()
            column = Gtk.TreeViewColumn(col, renderer, text=i)
            column.set_resizable(True)
            if i == 1:
                column.set_expand(True)
            sys_view.append_column(column)
        sc2 = Gtk.ScrolledWindow()
        sc2.set_vexpand(True)
        sc2.add(sys_view)
        sys_box.pack_start(sc2, True, True, 0)

        hint = Gtk.Label(label="Lista detectada automaticamente do hyprland.lua (somente leitura). Alguns binds (funções/loops complexos) podem aparecer simplificados.")
        hint.get_style_context().add_class("muted")
        hint.set_halign(Gtk.Align.START)
        hint.set_line_wrap(True)
        sys_box.pack_start(hint, False, False, 0)

        bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        bottom.set_halign(Gtk.Align.END)
        outer.pack_start(bottom, False, False, 0)
        close_btn = Gtk.Button(label="Fechar")
        close_btn.connect("clicked", lambda *_: Gtk.main_quit())
        bottom.pack_start(close_btn, False, False, 0)

        self.reload_store()
        self.reload_system()

    def bind_label(self, b):
        mods = combo_to_bind_mods(b.get("mods", "SUPER"))
        key = str(b.get("key", "")).strip()
        return f"{mods} + {key}" if mods else key

    def reload_store(self):
        self.store.clear()
        for b in self.binds:
            self.store.append([self.bind_label(b), str(b.get("command", "")), str(b.get("description", ""))])

    def reload_system(self):
        self.sys_store.clear()
        for b in parse_existing_binds():
            self.sys_store.append([b.get("keys", ""), b.get("action", "")])

    def selected_index(self):
        sel = self.view.get_selection()
        model, it = sel.get_selected()
        if it is None:
            return None
        return model.get_path(it).get_indices()[0]

    def on_add(self, *_):
        dlg = BindDialog(self, "Adicionar atalho")
        resp = dlg.run()
        if resp == Gtk.ResponseType.OK:
            b = dlg.get_bind()
            if b["key"] and b["command"]:
                self.binds.append(b)
                self.reload_store()
        dlg.destroy()

    def on_edit(self, *_):
        idx = self.selected_index()
        if idx is None:
            return
        dlg = BindDialog(self, "Editar atalho", self.binds[idx])
        resp = dlg.run()
        if resp == Gtk.ResponseType.OK:
            b = dlg.get_bind()
            if b["key"] and b["command"]:
                self.binds[idx] = b
                self.reload_store()
        dlg.destroy()

    def on_remove(self, *_):
        idx = self.selected_index()
        if idx is None:
            return
        del self.binds[idx]
        self.reload_store()

    def on_save(self, *_):
        try:
            save_all(self.binds)
            md = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.INFO,
                                   buttons=Gtk.ButtonsType.OK, text="Atalhos salvos e aplicados.")
            md.format_secondary_text(f"Gerado: {LUA_PATH}\nHyprland recarregado (hyprctl reload).")
        except Exception as e:
            md = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.ERROR,
                                   buttons=Gtk.ButtonsType.OK, text="Falha ao salvar/aplicar.")
            md.format_secondary_text(str(e))
        md.run()
        md.destroy()


def main():
    win = BindsWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
