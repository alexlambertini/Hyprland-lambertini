#!/usr/bin/env python3
"""Aplica os widgets do Painel de Widgets.

Faz o layout em colunas medindo a altura REAL de cada widget (via
`hyprctl layers`) e empilhando como um "float": cada widget fica logo
abaixo do anterior, sem distâncias fixas.
"""
import json
import os
import re
import subprocess
import time

STATE = os.path.expanduser("~/.config/conky/widgets.json")
FALLBACK_HEIGHT = 260
GAP_BETWEEN = 50  # margem superior de cada widget em relacao ao de cima


def get_hypr_sig():
    base = "/run/user/%d/hypr" % os.getuid()

    def valid(sig):
        return bool(sig) and os.path.exists(os.path.join(base, sig, ".socket.sock"))

    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if valid(sig):
        return sig
    try:
        names = [n for n in os.listdir(base) if valid(n)]
        names.sort(key=lambda n: os.path.getmtime(os.path.join(base, n)), reverse=True)
        return names[0] if names else None
    except Exception:
        return None


def hyprctl(args):
    env = os.environ.copy()
    sig = get_hypr_sig()
    if sig:
        env["HYPRLAND_INSTANCE_SIGNATURE"] = sig
    try:
        return subprocess.run(["hyprctl"] + args, capture_output=True, text=True, env=env)
    except Exception:
        return None


def load_state():
    try:
        with open(STATE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {"widgets": [], "margin_top": 30}


def save_state(state):
    try:
        with open(STATE, "w", encoding="utf-8") as f:
            json.dump(state, f, ensure_ascii=False, indent=2)
            f.write("\n")
    except Exception:
        pass


def update_conky_position(conf_path, alignment, gap_x, gap_y):
    if not conf_path or not os.path.isfile(conf_path):
        return False
    try:
        with open(conf_path, "r", encoding="utf-8") as f:
            s = f.read()
    except Exception:
        return False
    s = re.sub(r"alignment = '[^']*',", "alignment = '%s'," % alignment, s)
    s = re.sub(r"gap_x = \d+,", "gap_x = %d," % int(gap_x), s)
    s = re.sub(r"gap_y = -?\d+,", "gap_y = %d," % int(gap_y), s)
    try:
        with open(conf_path, "w", encoding="utf-8") as f:
            f.write(s)
        return True
    except Exception:
        return False


def start_widget(conf):
    return subprocess.Popen(["conky", "-c", conf], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                            start_new_session=True)


def kill_conky():
    subprocess.run(["pkill", "-x", "conky"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def measure_heights():
    """Retorna {pid: altura} das camadas conky atuais."""
    r = hyprctl(["layers", "-j"])
    heights = {}
    if not r or r.returncode != 0:
        return heights
    try:
        data = json.loads(r.stdout)
    except Exception:
        return heights
    for mon, mdata in data.items():
        for level, items in (mdata.get("levels") or {}).items():
            for it in items:
                if it.get("namespace") == "conky_namespace":
                    try:
                        heights[int(it.get("pid"))] = int(it.get("h"))
                    except Exception:
                        pass
    return heights


def apply():
    state = load_state()
    widgets = state.get("widgets", [])
    margin_top = int(state.get("margin_top", 30))
    gap_between = int(state.get("gap_between", GAP_BETWEEN))

    enabled = [w for w in widgets if w.get("enabled", False) and w.get("config")
               and os.path.isfile(w.get("config"))]

    # Fase 1: iniciar no topo apenas para medir a altura real de cada um
    kill_conky()
    time.sleep(0.3)
    procs = []
    for w in enabled:
        update_conky_position(w["config"], w.get("alignment", "top_right"), w.get("gap_x", 20), 0)
        procs.append((w, start_widget(w["config"])))
        time.sleep(0.25)
    time.sleep(1.3)

    heights = measure_heights()
    for w, p in procs:
        h = heights.get(p.pid)
        w["_h"] = h if h else FALLBACK_HEIGHT

    # Fase 2: calcular empilhamento por coluna (na ordem da lista)
    cols = {"top_left": margin_top, "top_right": margin_top}
    for w in widgets:
        if not w.get("enabled", False):
            continue
        align = w.get("alignment", "top_right")
        if align not in cols:
            align = "top_left" if "left" in str(align) else "top_right"
            w["alignment"] = align
        w["gap_y"] = cols[align]
        cols[align] += int(w.get("_h", FALLBACK_HEIGHT)) + gap_between

    # Fase 3: reescrever posições e reiniciar
    kill_conky()
    time.sleep(0.3)
    for w in enabled:
        update_conky_position(w["config"], w.get("alignment", "top_right"), w.get("gap_x", 20), w.get("gap_y", margin_top))
    for w in enabled:
        start_widget(w["config"])
        time.sleep(0.25)

    # limpar campos temporários e salvar estado
    for w in widgets:
        w.pop("_h", None)
    state["widgets"] = widgets
    save_state(state)


if __name__ == "__main__":
    apply()
